statusLabel.TextXAlignment = Enum.TextXAlignment.Left

-- Logic
local connected
local isRunning = false
local dis = 1000
local blacklist = {}
local playerButtons = {}

local function setStatus(text, color)
	statusLabel.Text = text
	statusLabel.TextColor3 = color or Color3.fromRGB(100, 100, 110)
end

-- สร้างปุ่มชื่อผู้เล่น
local function refreshPlayerList()
	for _, b in pairs(playerButtons) do
		b:Destroy()
	end

	playerButtons = {}

	for _, v in ipairs(Players:GetPlayers()) do
		if v ~= LocalPlayer then
			local pb = Instance.new("TextButton")
			pb.Parent = scrollFrame
			pb.Size = UDim2.new(1, -6, 0, 26)
			pb.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
			pb.BorderSizePixel = 0
			pb.Text = v.Name
			pb.TextSize = 12
			pb.Font = Enum.Font.Gotham
			pb.TextXAlignment = Enum.TextXAlignment.Left

			Instance.new("UICorner", pb).CornerRadius = UDim.new(0, 6)

			if table.find(blacklist, v.Name) then
				pb.TextColor3 = Color3.fromRGB(0, 170, 255)
			else
				pb.TextColor3 = Color3.fromRGB(200, 200, 210)
			end

			pb.MouseButton1Click:Connect(function()
				local found = table.find(blacklist, v.Name)

				if found then
					table.remove(blacklist, found)
				else
					table.insert(blacklist, v.Name)
				end

				refreshPlayerList()
			end)

			table.insert(playerButtons, pb)
		end
	end

	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, scrollLayout.AbsoluteContentSize.Y)
end


task.spawn(function()
	while true do
		refreshPlayerList()
		task.wait(3)
	end
end)

textbox.FocusLost:Connect(function()
	local num = tonumber(textbox.Text)
	if num then
		dis = num
	else
		textbox.Text = tostring(dis)
	end
end)

local function stopTp()
	if connected then connected:Disconnect() connected = nil end
	isRunning = false
	button.Text = "▶  Start TP"
	button.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
	btnStroke.Color = Color3.fromRGB(70, 70, 80)
	setStatus("● Idle")
end

local function followTarget(target)
	if connected then connected:Disconnect() connected = nil end
	connected = RunService.RenderStepped:Connect(function()
		local myChar = LocalPlayer.Character
		local targetChar = target.Character
		if not myChar or not targetChar then return end
		local myRoot = myChar:FindFirstChild("HumanoidRootPart")
		local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
		if not myRoot or not targetRoot then return end
		if (myRoot.Position - targetRoot.Position).Magnitude > dis then return end
		local offset = targetRoot.CFrame * CFrame.new(0, 1.5, 2)
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.CFrame = offset
	end)
end

local function tp()
	if isRunning then stopTp() return end
	isRunning = true
	button.Text = "■  Stop TP"
	button.BackgroundColor3 = Color3.fromRGB(80, 25, 25)
	btnStroke.Color = Color3.fromRGB(180, 60, 60)

	task.spawn(function()
		local index = 1
		while isRunning do
			local others = {}
			for _, v in ipairs(Players:GetPlayers()) do
				if v ~= LocalPlayer and not table.find(blacklist, v.Name) then table.insert(others, v) end
			end

				if #others > 0 then
					if index > #others then index = 1 end
					local target = others[index]
					setStatus("● Following: " .. target.Name, Color3.fromRGB(80, 200, 120))
					followTarget(target)
					index = index + 1
				else
					setStatus("● No players found", Color3.fromRGB(200, 150, 60))
				end
				task.wait(5)
		end
	end)
end

local function setupCharacter(char)
	local humanoid = char:WaitForChild("Humanoid")

	humanoid.Died:Connect(function()
		stopTp()
	end)
end

if LocalPlayer.Character then
	setupCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(setupCharacter)

button.MouseButton1Click:Connect(tp)
button.MouseEnter:Connect(function()
	if not isRunning then button.BackgroundColor3 = Color3.fromRGB(50, 50, 58) end
end)
button.MouseLeave:Connect(function()
	if not isRunning then button.BackgroundColor3 = Color3.fromRGB(35, 35, 40) end
end)

UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessedEvent: boolean) 
	if gameProcessedEvent then return end
	if input.KeyCode == Enum.KeyCode.H then
		panel.Visible = not panel.Visible
	end
end)
